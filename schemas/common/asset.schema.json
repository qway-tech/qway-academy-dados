{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qway.dev/schemas/content-plane/v2/common/asset.schema.json",
  "title": "QWay Content Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "role",
    "path"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "role": {
      "type": "string",
      "enum": [
        "primary",
        "cover",
        "thumbnail",
        "attachment",
        "source",
        "supplementary"
      ]
    },
    "mediaType": {
      "type": "string",
      "minLength": 3
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!https?://).+$"
    }
  }
}
