{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qway.dev/schemas/content-plane/v2/resources/resources-catalog.schema.json",
  "title": "QWay Generated Resources Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatorVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "generatorVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "collection",
          "type",
          "status",
          "sourceLocale",
          "availableLocales",
          "contentPath",
          "locales"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^resource:[a-z0-9-]+:[a-z0-9-]+$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "collection": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "published",
              "archived"
            ]
          },
          "sourceLocale": {
            "type": "string",
            "enum": [
              "pt",
              "en",
              "es"
            ]
          },
          "availableLocales": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "pt",
                "en",
                "es"
              ]
            }
          },
          "contentPath": {
            "type": "string",
            "pattern": "^content/resources/"
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "maintainers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "metadata": {
            "type": "object"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "locales": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "pt",
                "en",
                "es"
              ]
            },
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
