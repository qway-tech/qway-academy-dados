{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qway.dev/schemas/content-plane/v2/common/relation.schema.json",
  "title": "QWay Content Relations",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "parent": {
      "$ref": "#/$defs/entityId"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityId"
      },
      "uniqueItems": true
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityId"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*){2,}$"
    }
  }
}
